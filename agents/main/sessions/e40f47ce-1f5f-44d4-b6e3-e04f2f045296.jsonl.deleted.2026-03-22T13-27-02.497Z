{"type":"message","id":"2d8b9062","parentId":"93afcb2c","timestamp":"2026-03-21T13:28:06.747Z","message":{"role":"toolResult","toolCallId":"call_vgzrtt5qykhxg5za6lea0t73","toolName":"gateway","content":[{"type":"text","text":"{\n  \"ok\": true,\n  \"result\": {\n    \"path\": \"web\",\n    \"schema\": {\n      \"type\": \"object\",\n      \"additionalProperties\": false\n    },\n    \"hint\": {\n      \"label\": \"Web Channel\",\n      \"help\": \"Web channel runtime settings for heartbeat and reconnect behavior when operating web-based chat surfaces. Use reconnect values tuned to your network reliability profile and expected uptime needs.\",\n      \"tags\": [\n        \"advanced\"\n      ]\n    },\n    \"hintPath\": \"web\",\n    \"children\": [\n      {\n        \"key\": \"enabled\",\n        \"path\": \"web.enabled\",\n        \"type\": \"boolean\",\n        \"required\": false,\n        \"hasChildren\": false,\n        \"hint\": {\n          \"label\": \"Web Channel Enabled\",\n          \"help\": \"Enables the web channel runtime and related websocket lifecycle behavior. Keep disabled when web chat is unused to reduce active connection management overhead.\",\n          \"tags\": [\n            \"advanced\"\n          ]\n        },\n        \"hintPath\": \"web.enabled\"\n      },\n      {\n        \"key\": \"heartbeatSeconds\",\n        \"path\": \"web.heartbeatSeconds\",\n        \"type\": \"integer\",\n        \"required\": false,\n        \"hasChildren\": false,\n        \"hint\": {\n          \"label\": \"Web Channel Heartbeat Interval (sec)\",\n          \"help\": \"Heartbeat interval in seconds for web channel connectivity and liveness maintenance. Use shorter intervals for faster detection, or longer intervals to reduce keepalive chatter.\",\n          \"tags\": [\n            \"automation\"\n          ]\n        },\n        \"hintPath\": \"web.heartbeatSeconds\"\n      },\n      {\n        \"key\": \"reconnect\",\n        \"path\": \"web.reconnect\",\n        \"type\": \"object\",\n        \"required\": false,\n        \"hasChildren\": true,\n        \"hint\": {\n          \"label\": \"Web Channel Reconnect Policy\",\n          \"help\": \"Reconnect backoff policy for web channel reconnect attempts after transport failure. Keep bounded retries and jitter tuned to avoid thundering-herd reconnect behavior.\",\n          \"tags\": [\n            \"advanced\"\n          ]\n        },\n        \"hintPath\": \"web.reconnect\"\n      }\n    ]\n  }\n}"}],"details":{"ok":true,"result":{"path":"web","schema":{"type":"object","additionalProperties":false},"hint":{"label":"Web Channel","help":"Web channel runtime settings for heartbeat and reconnect behavior when operating web-based chat surfaces. Use reconnect values tuned to your network reliability profile and expected uptime needs.","tags":["advanced"]},"hintPath":"web","children":[{"key":"enabled","path":"web.enabled","type":"boolean","required":false,"hasChildren":false,"hint":{"label":"Web Channel Enabled","help":"Enables the web channel runtime and related websocket lifecycle behavior. Keep disabled when web chat is unused to reduce active connection management overhead.","tags":["advanced"]},"hintPath":"web.enabled"},{"key":"heartbeatSeconds","path":"web.heartbeatSeconds","type":"integer","required":false,"hasChildren":false,"hint":{"label":"Web Channel Heartbeat Interval (sec)","help":"Heartbeat interval in seconds for web channel connectivity and liveness maintenance. Use shorter intervals for faster detection, or longer intervals to reduce keepalive chatter.","tags":["automation"]},"hintPath":"web.heartbeatSeconds"},{"key":"reconnect","path":"web.reconnect","type":"object","required":false,"hasChildren":true,"hint":{"label":"Web Channel Reconnect Policy","help":"Reconnect backoff policy for web channel reconnect attempts after transport failure. Keep bounded retries and jitter tuned to avoid thundering-herd reconnect behavior.","tags":["advanced"]},"hintPath":"web.reconnect"}]}},"isError":false,"timestamp":1774099686746}}
