<26:22, 1.89MiB/s]\r  3%|��                                    | 87.9M/2.87G [00:41<26:48, 1.86MiB/s]\r  3%|��                                    | 88.1M/2.87G [00:41<25:48, 1.93MiB/s]\r  3%|��                                    | 88.3M/2.87G [00:41<25:49, 1.93MiB/s]\r  3%|��                                    | 88.5M/2.87G [00:41<43:46, 1.14MiB/s]\r  3%|��                                    | 88.7M/2.87G [00:41<38:33, 1.29MiB/s]\r  3%|��                                    | 88.9M/2.87G [00:41<35:33, 1.40MiB/s]\r  3%|��                                    | 89.1M/2.87G [00:41<31:01, 1.61MiB/s]\r  3%|��                                    | 89.2M/2.87G [00:42<30:04, 1.66MiB/s]\r  3%|��                                    | 89.4M/2.87G [00:42<28:22, 1.76MiB/s]\r  3%|����                                   | 89.7M/2.87G [00:42<26:31, 1.88MiB/s]\r  3%|����                                   | 89.9M/2.87G [00:42<25:38, 1.94MiB/s]\r  3%|����                                   | 90.1M/2.87G [00:42<25:12, 1.98MiB/s]\r  3%|����                                   | 90.3M/2.87G [00:42<24:11, 2.06MiB/s]\r  3%|����                                   | 90.5M/2.87G [00:42<24:17, 2.05MiB/s]\r  3%|����                                   | 90.7M/2.87G [00:42<23:50, 2.09MiB/s]\r  3%|����                                   | 90.9M/2.87G [00:42<23:44, 2.10MiB/s]\r  3%|����                                   | 91.1M/2.87G [00:43<23:40, 2.11MiB/s]\r  3%|����                                   | 91.3M/2.87G [00:43<23:28, 2.12MiB/s]\r  3%|����                                   | 91.5M/2.87G [00:43<23:28, 2.12MiB/s]\r  3%|����                                   | 91.8M/2.87G [00:43<23:39, 2.11MiB/s]\r  3%|����                                   | 92.0M/2.87G [00:43<23:49, 2.09MiB/s]\r  3%|����                                   | 92.2M/2.87G [00:43<23:23, 2.13MiB/s]"}],"details":{"status":"running","sessionId":"dawn-zephyr","total":8,"totalLines":8,"totalChars":33247,"truncated":true,"name":"cd video_download"},"isError":false,"timestamp":1773768986715}}
