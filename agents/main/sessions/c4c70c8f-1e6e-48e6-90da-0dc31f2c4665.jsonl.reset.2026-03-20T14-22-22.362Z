title_run = subtitle.add_run('讲师：王秀萍 | 语音识别转录')\nsubtitle_run.font.size = Pt(12)\nsubtitle_run.font.color.rgb = RGBColor(100, 100, 100)\nsubtitle.alignment = WD_ALIGN_PARAGRAPH.CENTER\n\ndoc.add_paragraph()\n\n# 添加逐字稿标题\nsection_title = doc.add_paragraph()\nsection_run = section_title.add_run('【课堂逐字稿】')\nsection_run.font.name = 'Microsoft YaHei'\nsection_run.font.size = Pt(14)\nsection_run.font.bold = True\n\ndoc.add_paragraph()\n\n# 处理内容\nfor line in lines:\n    line = line.strip()\n    if not line or line.startswith('视频标题:') or line.startswith('讲师:') or line.startswith('BV号:'):\n        continue\n    if line.startswith('=') or line == '【课堂逐字稿】':\n        continue\n    \n    # 处理时间戳行\n    if line.startswith('[') and ']' in line:\n        import re\n        match = re.match(r'[(d{2}:(d{2})] (.+)', line)\n        if match:\n            timestamp = match.group(1)\n            text = match.group(2).strip()\n            \n            if text:\n                p = doc.add_paragraph()\n                time_run = p.add_run(f'[{timestamp}] ')\n                time_run.font.size = Pt(10)\n                time_run.font.color.rgb = RGBColor(150, 150, 150)\n                \n                text_run = p.add_run(text)\n                text_run.font.size = Pt(11)\n    else:\n        # 普通文本\n        if line:\n            p = doc.add_paragraph(line)\n            p.paragraph_format.line_spacing = 1.15\n\n# 添加结尾\ndoc.add_paragraph()\nend = doc.add_paragraph('—— 课程结束 ——')\nend.alignment = WD_ALIGN_PARAGRAPH.CENTER\n\n# 保存文档\noutput_path = '四年级下册《看看我们的地球》导读课-逐字稿.docx'\ndoc.save(output_path)\nprint(f'✅ Word文档已生成: {output_path}')\n\"\n","workdir":"C:\\Users\\LWS\\.openclaw\\workspace"}}],"api":"openai-completions","provider":"volcengine-plan","model":"kimi-k2.5","usage":{"input":0,"output":0,"cacheRead":0,"cacheWrite":0,"totalTokens":0,"cost":{"input":0,"output":0,"cacheRead":0,"cacheWrite":0,"total":0}},"stopReason":"toolUse","timestamp":1773879573617}}
